# YouTube Topic Finder - Environment Variables
# Copy this file to .env and fill in your actual values

# Application Settings
APP_NAME="YouTube Topic Finder"
APP_VERSION="1.0.0"
DEBUG=false
LOG_LEVEL=INFO

# Supabase Database Configuration (Cloud PostgreSQL)
# Get your connection string from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/database
# Use the "Transaction Pooler" connection string for best performance
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_ID:[YOUR_PASSWORD]@aws-1-eu-north-1.pooler.supabase.com:6543/postgres
SQL_ECHO=false

# Redis Configuration (Local Cache/Queue)
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_MAX_CONNECTIONS=10

# YouTube Data API v3
# Get key from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key_here

# Google Ads API (for keyword search volume)
# Setup: https://developers.google.com/google-ads/api/docs/first-call/overview
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token_here
GOOGLE_ADS_CLIENT_ID=your_client_id_here
GOOGLE_ADS_CLIENT_SECRET=your_client_secret_here
GOOGLE_ADS_REFRESH_TOKEN=your_refresh_token_here

# Reddit API
# Get credentials from: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT="YouTubeTopicFinder/1.0"

# OpenAI API (for Whisper transcription)
# Get key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Niche Configuration
DEFAULT_NICHE=ai_tech
CONFIG_DIR=config/niches

# Robot 1: Horizon Scanner Settings
ROBOT1_GOOGLE_TRENDS_ENABLED=true
ROBOT1_REDDIT_ENABLED=true
ROBOT1_MAX_TOPICS_PER_RUN=20

# Robot 2: SERP Scraper Settings
ROBOT2_MAX_VIDEOS_PER_QUERY=50
ROBOT2_PLAYWRIGHT_ENABLED=true
ROBOT2_API_FALLBACK=true
ROBOT2_REQUEST_DELAY_SECONDS=2

# Robot 3: Metric Analyzer Settings
ROBOT3_YOUTUBE_API_ENABLED=true
ROBOT3_GOOGLE_ADS_ENABLED=false
ROBOT3_BATCH_SIZE=50

# Robot 4: Format Classifier Settings
# Whisper model sizes: tiny, base, small, medium, large
ROBOT4_WHISPER_MODEL=base
ROBOT4_MAX_AUDIO_LENGTH_SECONDS=600
ROBOT4_DOWNLOAD_AUDIO=true

# Rate Limiting
YOUTUBE_API_DAILY_QUOTA=10000
REDDIT_API_REQUESTS_PER_MINUTE=60

# Processing
MAX_CONCURRENT_JOBS=5
JOB_TIMEOUT_SECONDS=3600

# Paths
LOG_DIR=logs
DOWNLOAD_DIR=downloads
TEMP_DIR=temp

# React Dashboard Configuration (Coming Soon)
# These will be used when the React dashboard is implemented
DASHBOARD_PORT=3000
DASHBOARD_API_BASE_URL=http://localhost:8000
DASHBOARD_REALTIME_ENABLED=true
DASHBOARD_EXPORT_FORMATS=json,csv,xlsx
DASHBOARD_AUTO_REFRESH_SECONDS=30

# Supabase Features (For future React integration)
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Webhook Configuration (For future integrations)
WEBHOOK_ENABLED=false
WEBHOOK_URL=https://your-webhook-endpoint.com
WEBHOOK_SECRET=your_webhook_secret_here
WEBHOOK_EVENTS=topic_discovered,opportunity_found,pipeline_complete
